FROM alpine:3.23

RUN apk update && apk add --no-cache \
    php84 php84-fpm php84-mysqli php84-json php84-curl php84-dom \
    php84-exif php84-fileinfo php84-mbstring php84-openssl php84-xml \
    php84-zip php84-phar php84-session php84-tokenizer php84-ctype \
    php84-iconv php84-simplexml php84-gd php84-pdo php84-pdo_mysql \
    curl wget bash mariadb-client iputils

# Créer l'utilisateur pour PHP-FPM
RUN addgroup -S www && adduser -S -G www www

RUN curl -o /usr/local/bin/wp https://raw.githubusercontent.com/wp-cli/builds/gh-pages/phar/wp-cli.phar \
    && chmod +x /usr/local/bin/wp

RUN mkdir -p /var/www/html

COPY conf/php.ini /etc/php84/php.ini
COPY conf/www.conf /etc/php84/php-fpm.d/www.conf

COPY tools/ /tools/

RUN chmod +x /tools/install_wordpress.sh

EXPOSE 9000

ENTRYPOINT [ "/tools/install_wordpress.sh" ]

CMD ["php-fpm84", "-F"]